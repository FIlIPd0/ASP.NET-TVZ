@model Tag
@{
    ViewData["Title"] = "Tag Details";
}

<section class="ux-page">
    <div class="ux-detail-hero">
        <h2>@Model.Name</h2>
        <p>Pregled svih datoteka koje koriste ovaj tag.</p>
    </div>

    <section class="ux-card-slab">
        <h3>Tag Meta</h3>
        <div class="ux-chip-row">
            <span class="ux-chip ux-chip-tag" style="background-color:@Model.ColorHex;">@Model.ColorHex</span>
            <span class="ux-chip">Used in @Model.MediaFiles.Count files</span>
        </div>
    </section>

    <section class="ux-card-slab">
        <h3>Related Files</h3>
        @if (Model.MediaFiles.Count == 0)
        {
            <div class="ux-empty">Nema povezanih datoteka.</div>
        }
        else
        {
            <div class="ux-ledger-wrap">
                <table class="ux-ledger-table">
                    <thead>
                    <tr>
                        <th>File</th>
                        <th>Type</th>
                        <th>Owner</th>
                        <th>Storage</th>
                        <th></th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var media in Model.MediaFiles.OrderByDescending(media => media.AddedAt))
                    {
                        <tr>
                            <td>@media.FileName</td>
                            <td>@media.MediaType</td>
                            <td><a asp-controller="AppUsers" asp-action="Details" asp-route-id="@media.Owner.Id">@media.Owner.Username</a></td>
                            <td><a asp-controller="StorageDevices" asp-action="Details" asp-route-id="@media.StorageDevice.Id">@media.StorageDevice.Name</a></td>
                            <td><a asp-controller="LocalMediaFiles" asp-action="Details" asp-route-id="@media.Id">Details</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="ux-link-cluster">
        <a class="ux-link-button" asp-action="Index">Back to tags</a>
    </div>
</section>

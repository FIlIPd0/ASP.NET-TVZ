@model IEnumerable<AppUser>
@{
    ViewData["Title"] = "Users";
    var users = Model.ToList();
}

<section class="ux-page">
    <div class="ux-page-header">
        <h2>App Users</h2>
        <p>Pregled svih korisnika i njihovih kolekcija.</p>
    </div>

    <div class="ux-stat-strip">
        <article class="ux-stat-card">
            <span class="ux-stat-label">Total Users</span>
            <span class="ux-stat-value">@users.Count</span>
        </article>
        <article class="ux-stat-card">
            <span class="ux-stat-label">Premium Users</span>
            <span class="ux-stat-value">@users.Count(user => user.IsPremium)</span>
        </article>
        <article class="ux-stat-card">
            <span class="ux-stat-label">Uploaded Files</span>
            <span class="ux-stat-value">@users.Sum(user => user.UploadedFiles.Count)</span>
        </article>
    </div>

    <section class="ux-card-slab">
        <h3>User Ledger</h3>
        <div class="ux-ledger-wrap">
            <table class="ux-ledger-table">
                <thead>
                <tr>
                    <th>Username</th>
                    <th>Email</th>
                    <th>City</th>
                    <th>Status</th>
                    <th>Files</th>
                    <th>Playlists</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                @foreach (var user in users)
                {
                    <tr>
                        <td>@user.Username</td>
                        <td>@user.Email</td>
                        <td>@user.City</td>
                        <td>
                            <span class="ux-chip @(user.IsPremium ? "status-ok" : "status-warn")">@(user.IsPremium ? "premium" : "standard")</span>
                        </td>
                        <td>@user.UploadedFiles.Count</td>
                        <td>@user.Playlists.Count</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@user.Id">Details</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>
</section>
